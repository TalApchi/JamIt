{
  "name": "jamit",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "calibrate:desktop": "node scripts/desktop-calibration-server.js",
    "calibrate:desktop:kalimba": "cross-env INSTRUMENT=kalimba node scripts/desktop-calibration-server.js",
    "calibrate:desktop:melodica": "cross-env INSTRUMENT=melodica node scripts/desktop-calibration-server.js",
    "calibrate:desktop:synthbass": "cross-env INSTRUMENT=synthBass node scripts/desktop-calibration-server.js",
    "typecheck": "tsc --noEmit",
    "test:music": "node scripts/test-scale-engine.js",
    "test:mapping": "node scripts/test-audio-mapping.js",
    "test:mapping:kalimba": "node scripts/test-kalimba-mapping.js",
    "test:mapping:melodica": "node scripts/test-melodica-mapping.js",
    "test:mapping:synthbass": "node scripts/test-synthbass-mapping.js",
    "test": "npm run typecheck && npm run test:music && npm run test:mapping && npm run test:mapping:kalimba && npm run test:mapping:melodica && npm run test:mapping:synthbass"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-haptics": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-status-bar": "~3.0.9",
    "react": "^19.1.0",
    "react-native": "^0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "typescript": "~5.8.3"
  }
}
